# ==============================================================================
# BACKEND ENVIRONMENT TEMPLATE — GOBLIN NATURE BINGO
# ==============================================================================
# Copy this file to '.env' and populate your local or production credentials.

# Server binding (Render dynamically sets PORT)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Local Ollama runner configuration (100% free offline AI inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=moondream
OLLAMA_CHAT_MODEL=gemma2:2b

# Cloud Vision Fallback (Optional — Groq free tier for mobile trail roaming)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-11b-vision-preview

# Voice Synthesis (Optional — ElevenLabs TTS)
# Free trial at: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Monitoring (Optional — Sentry tracing for hackathon evaluation)
SENTRY_DSN=

# Allowed CORS Origins (comma-separated URLs for web clients)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
