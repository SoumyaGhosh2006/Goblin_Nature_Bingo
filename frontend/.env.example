# ==============================================================================
# FRONTEND ENVIRONMENT TEMPLATE — GOBLIN NATURE BINGO
# ==============================================================================
# Copy this file to '.env' and specify your local or Render backend endpoint.
# Cloud Firestore credentials are used for real-time multiplayer leaderboard sync.

# URL of the running FastAPI backend microservice
# Local development: http://localhost:8000
# Production Render: https://goblin-nature-bingo.onrender.com
VITE_API_URL=http://localhost:8000

# Optional direct Groq key for emergency trail mode without backend
VITE_GROQ_API_KEY=

# ------------------------------------------------------------------------------
# FIREBASE WEB CONFIGURATION (SPARK PLAN / CLOUD FIRESTORE)
# ------------------------------------------------------------------------------
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
